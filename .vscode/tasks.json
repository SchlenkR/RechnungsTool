{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/src/RechnungsTool/RechnungsTool.csproj"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/src/RechnungsTool/RechnungsTool.csproj"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "detail": "Baut und startet die App (ohne Debugger)"
        },
        {
            "label": "publish-macos",
            "type": "shell",
            "command": "${workspaceFolder}/build/publish-macos.sh",
            "group": "build",
            "problemMatcher": "$msCompile",
            "detail": "Self-contained RechnungsTool.app nach dist/osx-arm64 (build/publish-macos.sh)"
        },
        {
            "label": "release-macos",
            "type": "shell",
            "command": "${workspaceFolder}/build/release-macos.sh",
            "group": "build",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
            "detail": "Lokaler GitHub-Release vom Mac (baut, zippt, veröffentlicht; schneller als CI)"
        }
    ]
}
