{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/src/RechnungsTool/RechnungsTool.csproj"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish-macos",
            "type": "shell",
            "command": "${workspaceFolder}/build/publish-macos.sh",
            "group": "build",
            "problemMatcher": "$msCompile",
            "detail": "Self-contained RechnungsTool.app nach dist/osx-arm64 (build/publish-macos.sh)"
        }
    ]
}
