<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RechnungsTool.ViewModels"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="920"
        x:Class="RechnungsTool.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icon.png"
        Width="1440" Height="920"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Title="RechnungsTool">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="ListBox.nav ListBoxItem">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.itemAction">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Ausgeklappte Übersicht: Sidebar nimmt die volle Breite ein -->
        <Style Selector="Border.sidebar">
            <Setter Property="(Grid.ColumnSpan)" Value="1"/>
        </Style>
        <Style Selector="Border.sidebar.erweitert">
            <Setter Property="(Grid.ColumnSpan)" Value="2"/>
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- Kopfleiste -->
        <Border DockPanel.Dock="Top" Padding="20,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <ui:SymbolIcon Symbol="Document" FontSize="20" VerticalAlignment="Center"/>
                    <TextBlock Text="RechnungsTool" FontSize="17" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Classes="secondary"
                            Command="{Binding AlleSpeichernAusfuehrenCommand}"
                            ToolTip.Tip="Alle ungespeicherten Rechnungen und Stammdaten speichern">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ui:SymbolIcon Symbol="Save"/>
                            <TextBlock Text="Alle speichern"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost" Padding="8"
                            ToolTip.Tip="Auswertung"
                            Command="{Binding AuswertungOeffnenCommand}">
                        <ui:SymbolIcon Symbol="Calculator" FontSize="18"/>
                    </Button>
                    <Button Classes="ghost" Padding="8"
                            ToolTip.Tip="Stammdaten"
                            Command="{Binding StammdatenOeffnenCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <ui:SymbolIcon Symbol="People" FontSize="18"/>
                            <TextBlock Text="●" FontSize="9" VerticalAlignment="Top"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                       IsVisible="{Binding StammdatenDirty}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost" Padding="8"
                            ToolTip.Tip="Einstellungen"
                            Command="{Binding EinstellungenOeffnenCommand}">
                        <ui:SymbolIcon Symbol="Settings" FontSize="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Statuszeile unten -->
        <Border DockPanel.Dock="Bottom" Padding="20,5">
            <TextBlock Text="{Binding StatusZeile}" Classes="hint"/>
        </Border>

        <!-- Warnbanner: fremde XML-Dateien / kaputte stammdaten.xml -->
        <ui:InfoBar DockPanel.Dock="Top"
                    Margin="20,0,20,8"
                    Severity="Warning"
                    IsClosable="False"
                    Title="Datenordner"
                    Message="{Binding OrdnerWarnung}"
                    IsOpen="{Binding OrdnerWarnung, Converter={x:Static ObjectConverters.IsNotNull}}"/>

        <!-- Update-Banner (Over-the-air) -->
        <ui:InfoBar DockPanel.Dock="Top"
                    Margin="20,0,20,8"
                    Severity="Success"
                    IsClosable="True"
                    Title="Update"
                    Message="{Binding UpdateText}"
                    IsOpen="{Binding UpdateVerfuegbar, Mode=TwoWay}">
            <ui:InfoBar.ActionButton>
                <Button Classes="accent" Content="Jetzt aktualisieren"
                        Command="{Binding UpdateInstallierenCommand}"/>
            </ui:InfoBar.ActionButton>
        </ui:InfoBar>

        <Grid ColumnDefinitions="380,*" Margin="12,0,12,8">

            <!-- Sidebar: Rechnungsübersicht -->
            <Border Grid.Column="0" Classes="card sidebar" Padding="12"
                    Classes.erweitert="{Binding UebersichtErweitert}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
                        <Button Grid.Column="0" Classes="create"
                                HorizontalAlignment="Stretch"
                                Command="{Binding NeueRechnungCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Add"/>
                                <TextBlock Text="Neue Rechnung"/>
                            </StackPanel>
                        </Button>
                        <ToggleButton Grid.Column="1" Classes="ghost" Margin="8,0,0,0" Padding="8"
                                      IsChecked="{Binding UebersichtErweitert}"
                                      ToolTip.Tip="Übersicht aus-/einklappen (Tabellenansicht)">
                            <Panel>
                                <ui:SymbolIcon Symbol="ChevronRight" FontSize="16"
                                               IsVisible="{Binding !UebersichtErweitert}"/>
                                <ui:SymbolIcon Symbol="ChevronLeft" FontSize="16"
                                               IsVisible="{Binding UebersichtErweitert}"/>
                            </Panel>
                        </ToggleButton>
                    </Grid>

                    <TextBox DockPanel.Dock="Top" Margin="0,10,0,0"
                             Classes="clearButton"
                             Watermark="Suchen…"
                             Text="{Binding SuchText}"/>

                    <!-- Spaltenköpfe der Tabellenansicht -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="130,100,180,*,120,76"
                          Margin="12,10,12,0"
                          IsVisible="{Binding UebersichtErweitert}">
                        <TextBlock Grid.Column="0" Text="Nummer" Classes="hint" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Datum" Classes="hint" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Zeitraum" Classes="hint" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="Empfänger" Classes="hint" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="Summe" Classes="hint" FontWeight="SemiBold"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <ScrollViewer Margin="0,8,0,0">
                        <StackPanel>
                            <ListBox Name="RechnungsListe"
                                     Classes="nav" Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ItemsSource="{Binding Eintraege}"
                                     SelectedItem="{Binding AusgewaehlterEintrag}">
                                <ListBox.DataTemplates>
                                    <DataTemplate DataType="vm:JahresKopf">
                                        <StackPanel Margin="0,12,0,0" Spacing="3">
                                            <TextBlock Text="{Binding Text}"
                                                       FontWeight="Bold" FontSize="17"
                                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                            <Border Height="1" Background="#C5CCEA"/>
                                        </StackPanel>
                                    </DataTemplate>
                                    <DataTemplate DataType="vm:ListenEintrag">
                                        <Panel>
                                            <!-- Kompakte Darstellung (eingeklappt) -->
                                            <Grid ColumnDefinitions="*,Auto,Auto"
                                                  IsVisible="{Binding !$parent[ListBox].((vm:MainWindowViewModel)DataContext).UebersichtErweitert}">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding Titel}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="🔒" FontSize="11" VerticalAlignment="Center"
                                                                   ToolTip.Tip="Als PDF gespeichert – gegen Änderungen gesperrt"
                                                                   IsVisible="{Binding Gesperrt}"/>
                                                        <TextBlock Text="●" FontSize="10" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                                                   ToolTip.Tip="Ungespeicherte Änderungen"
                                                                   IsVisible="{Binding Editor.IstDirty, FallbackValue=False}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding EmpfaengerZeile}" FontSize="11"
                                                               Classes="hint"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ProblemText}" FontSize="11"
                                                               Foreground="IndianRed" TextWrapping="Wrap"
                                                               IsVisible="{Binding HatProblem}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="itemAction"
                                                        ToolTip.Tip="Rechnung speichern"
                                                        IsVisible="{Binding Editor.IstDirty, FallbackValue=False}"
                                                        Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).EintragSpeichernCommand}"
                                                        CommandParameter="{Binding}">
                                                    <ui:SymbolIcon Symbol="Save" FontSize="15" Foreground="#5B5FC7"/>
                                                </Button>
                                                <Button Grid.Column="2" Classes="itemAction"
                                                        ToolTip.Tip="Rechnung in neue Rechnung übernehmen"
                                                        IsVisible="{Binding KannVorlageSein}"
                                                        Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).NeueRechnungFuerEmpfaengerCommand}"
                                                        CommandParameter="{Binding}">
                                                    <ui:SymbolIcon Symbol="Add" FontSize="15" Foreground="#0E8174"/>
                                                </Button>
                                            </Grid>

                                            <!-- Tabellarische Darstellung (ausgeklappt) -->
                                            <Grid ColumnDefinitions="130,100,180,*,120,76"
                                                  IsVisible="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).UebersichtErweitert}">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Titel}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="🔒" FontSize="11" VerticalAlignment="Center"
                                                               ToolTip.Tip="Als PDF gespeichert – gegen Änderungen gesperrt"
                                                               IsVisible="{Binding Gesperrt}"/>
                                                    <TextBlock Text="●" FontSize="10" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                                               ToolTip.Tip="Ungespeicherte Änderungen"
                                                               IsVisible="{Binding Editor.IstDirty, FallbackValue=False}"/>
                                                    <TextBlock Text="⚠" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="IndianRed"
                                                               ToolTip.Tip="{Binding ProblemText}"
                                                               IsVisible="{Binding HatProblem}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding DatumText}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ZeitraumText}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding EmpfaengerZeile}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="4" Text="{Binding SummeText}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="5" Orientation="Horizontal"
                                                            HorizontalAlignment="Right">
                                                    <Button Classes="itemAction"
                                                            ToolTip.Tip="Rechnung speichern"
                                                            IsVisible="{Binding Editor.IstDirty, FallbackValue=False}"
                                                            Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).EintragSpeichernCommand}"
                                                            CommandParameter="{Binding}">
                                                        <ui:SymbolIcon Symbol="Save" FontSize="15" Foreground="#5B5FC7"/>
                                                    </Button>
                                                    <Button Classes="itemAction"
                                                            ToolTip.Tip="Rechnung in neue Rechnung übernehmen"
                                                            IsVisible="{Binding KannVorlageSein}"
                                                            Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).NeueRechnungFuerEmpfaengerCommand}"
                                                            CommandParameter="{Binding}">
                                                        <ui:SymbolIcon Symbol="Add" FontSize="15" Foreground="#0E8174"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Panel>
                                    </DataTemplate>
                                </ListBox.DataTemplates>
                            </ListBox>

                            <TextBlock Text="PAPIERKORB" Classes="hint"
                                       Margin="4,16,0,6" FontWeight="SemiBold"
                                       IsVisible="{Binding PapierkorbVorhanden}"/>
                            <ListBox Classes="nav" Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     IsVisible="{Binding PapierkorbVorhanden}"
                                     ItemsSource="{Binding PapierkorbEintraege}"
                                     SelectedItem="{Binding AusgewaehlterPapierkorbEintrag}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ListenEintrag">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Titel}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding EmpfaengerZeile}" FontSize="11"
                                                       Classes="hint"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Aktuelle Seite (Editor / Fehleransicht); bei ausgeklappter Übersicht ausgeblendet -->
            <Panel Grid.Column="1" Margin="12,0,0,0"
                   IsVisible="{Binding !UebersichtErweitert}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                            IsVisible="{Binding AktuelleSeite, Converter={x:Static ObjectConverters.IsNull}}">
                    <ui:SymbolIcon Symbol="Document" FontSize="40"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center"/>
                    <TextBlock Text="Rechnung auswählen oder neue Rechnung anlegen"
                               Classes="hint" FontSize="13"/>
                </StackPanel>
                <ContentControl Content="{Binding AktuelleSeite}"/>
            </Panel>

        </Grid>

    </DockPanel>

</Window>
